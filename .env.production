# Backend API base URL (production)
VITE_API_BASE_URL=https://stand-alone-it-server.onrender.com

# Socket.IO server URL (production — falls back to VITE_API_BASE_URL if unset)
VITE_SOCKET_URL=https://stand-alone-it-server.onrender.com

# TURN server for WebRTC relay (required for cross-network connections).
# Deploy a Coturn server or use Twilio NTS / Metered / Xirsys.
# VITE_TURN_URL=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential
