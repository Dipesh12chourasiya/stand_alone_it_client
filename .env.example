# Backend API base URL (required in production).
# In development, Vite's dev server proxies /api and /socket.io to the backend,
# so this can be left empty.
VITE_API_BASE_URL=https://stand-alone-it-server.onrender.com

# Socket.IO server URL (optional — falls back to VITE_API_BASE_URL if not set)
VITE_SOCKET_URL=https://stand-alone-it-server.onrender.com

# TURN server for WebRTC relay (required when peers are on different networks).
# Without TURN, ICE will fail across restrictive NATs (e.g. WiFi ↔ mobile data).
# Deploy a Coturn server or use a cloud service (Twilio NTS, Metered, Xirsys).
# VITE_TURN_URL=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential
